<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ghb</groupId>
        <artifactId>flash-sale-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>flash-sale-gateway</artifactId>
    <name>flash-sale-gateway</name>
    <description>API 网关（P1）：统一入口 /api/** 路由到单体、traceId 注入、CORS；P1-2 接入 Nacos 后切换为服务发现路由</description>

    <dependencies>
        <!-- WebFlux 网关（与 spring-boot-starter-web 互斥，本模块不引入 WebMVC） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>

        <!-- P1-2 服务发现：Nacos 客户端（网关自身也注册进 Nacos，便于控制台统一查看） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- lb:// 路由必需的客户端负载均衡器（Gateway 不会自动带入） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- P2 Day 4：复用 common 的状态码与 requestId 工具（网关统一鉴权需返回同一信封形态） -->
        <dependency>
            <groupId>com.ghb</groupId>
            <artifactId>flash-sale-common</artifactId>
        </dependency>
        <!-- 读 .env（管理令牌与各服务同源；须配合 boot 插件 workingDirectory） -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
        </dependency>

        <!-- 自身健康与指标（P1-2 交由 Prometheus 抓取） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- 单测（AuthGatewayFilterTest：准入规则纯单测，无需启动网关） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 网关是可执行应用：声明 boot 插件（库模块不得声明） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 与其它服务一致：以聚合根为工作目录，才能读到 .env 的 ADMIN_TOKEN -->
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
