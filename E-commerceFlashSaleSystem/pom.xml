<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        多模块父工程（第 5 阶段 P0：模块化单体）
        - 继续继承 Spring Boot 父 POM：所有三方依赖版本与单体现状保持完全一致
        - 依赖版本统一在 dependencyManagement；三方版本变更只在本文件发生
        - 库模块不要声明 spring-boot-maven-plugin，避免被 repackage 成可执行包
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.ghb</groupId>
    <artifactId>flash-sale-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>flash-sale-parent</name>
    <description>轻量级电商秒杀系统 - 多模块父工程（P0 模块化单体）</description>

    <modules>
        <module>flash-sale-common</module>
        <module>flash-sale-contracts</module>
        <module>flash-sale-domain-model</module>
        <module>flash-sale-infra</module>
        <module>flash-sale-auth-core</module>
        <module>flash-sale-product-core</module>
        <module>flash-sale-product</module>
        <module>flash-sale-activity</module>
        <module>flash-sale-seckill</module>
        <module>flash-sale-order</module>
        <module>flash-sale-analytics</module>
        <module>flash-sale-ai</module>
        <module>flash-sale-auth</module>
        <module>flash-sale-gateway</module>
        <module>flash-sale-bootstrap</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 三方版本：与单体保持一致（仅在此处维护） -->
        <redisson.version>3.34.0</redisson.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <aliyun-oss.version>3.17.4</aliyun-oss.version>
        <spring-dotenv.version>4.0.0</spring-dotenv.version>
        <mysql-connector.version>8.0.33</mysql-connector.version>
        <archunit.version>1.3.0</archunit.version>
        <!-- P1 基础设施：Spring Cloud 与 Boot 3.3.x 对齐（2023.0.x 分支） -->
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.3.2</spring-cloud-alibaba.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ========== 内部模块（版本统一跟随父工程） ========== -->
            <dependency>
                <groupId>com.ghb</groupId>
                <artifactId>flash-sale-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ghb</groupId>
                <artifactId>flash-sale-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ghb</groupId>
                <artifactId>flash-sale-domain-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ghb</groupId>
                <artifactId>flash-sale-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ghb</groupId>
                <artifactId>flash-sale-product-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ghb</groupId>
                <artifactId>flash-sale-product</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ghb</groupId>
                <artifactId>flash-sale-activity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ghb</groupId>
                <artifactId>flash-sale-seckill</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ghb</groupId>
                <artifactId>flash-sale-order</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ghb</groupId>
                <artifactId>flash-sale-analytics</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ghb</groupId>
                <artifactId>flash-sale-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ghb</groupId>
                <artifactId>flash-sale-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ghb</groupId>
                <artifactId>flash-sale-gateway</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ghb</groupId>
                <artifactId>flash-sale-bootstrap</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ========== Spring Cloud BOM（网关 / 后续注册发现） ========== -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========== Spring Cloud Alibaba BOM（Nacos 服务注册，P1-2） ========== -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========== 三方依赖（锁定与现状一致的版本） ========== -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- 仅注解包：供 flash-sale-domain-model 的实体使用（避免模型层引入整套 starter） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-annotation</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>me.paulschwarz</groupId>
                <artifactId>spring-dotenv</artifactId>
                <version>${spring-dotenv.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <version>${aliyun-oss.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql-connector.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- ========== 测试：架构约束（P0 Day 4 启用 ArchUnit 规则） ========== -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>com.ghb</groupId>
                <artifactId>flash-sale-auth-core</artifactId>
                <version>${project.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- ========== 全模块通用依赖：Lombok + 测试基座 ========== -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <!-- 排除 JUnit 4 的 vintage 引擎，避免版本冲突 -->
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!--
                            P0 关键点：子模块跑测试时以聚合根为工作目录，
                            spring-dotenv 才能读到根级 .env（MySQL 口令等），
                            uploads/ 等相对路径解析也与单体时期一致。
                        -->
                        <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
