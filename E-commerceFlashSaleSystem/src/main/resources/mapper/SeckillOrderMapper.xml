<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ghb.ecommerceflashsalesystem.mapper.SeckillOrderMapper">

    <!-- 基础结果映射：所有字段 -->
    <resultMap id="BaseResultMap" type="com.ghb.ecommerceflashsalesystem.domain.entity.SeckillOrder">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="order_no" property="orderNo" jdbcType="VARCHAR"/>
        <result column="activity_id" property="activityId" jdbcType="BIGINT"/>
        <result column="product_id" property="productId" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="seckill_price" property="seckillPrice" jdbcType="BIGINT"/>
        <result column="status" property="status" jdbcType="TINYINT"/>
        <result column="stream_message_id" property="streamMessageId" jdbcType="VARCHAR"/>
        <result column="failure_reason" property="failureReason" jdbcType="VARCHAR"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
        <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="selectByOrderNo" resultMap="BaseResultMap" parameterType="java.lang.String">
        SELECT
            id,
            order_no,
            activity_id,
            product_id,
            user_id,
            seckill_price,
            status,
            stream_message_id,
            failure_reason,
            created_at,
            updated_at
        FROM seckill_order
        WHERE order_no = #{orderNo,jdbcType=VARCHAR}
    </select>
</mapper>