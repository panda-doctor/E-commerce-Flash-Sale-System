<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ghb.ecommerceflashsalesystem.mapper.ProductMapper">

    <!-- 基础结果映射：所有字段 -->
    <resultMap id="BaseResultMap" type="com.ghb.ecommerceflashsalesystem.domain.entity.Product">
        <id column="id" property="id" jdbcType="BIGINT" />
        <result column="name" property="name" jdbcType="VARCHAR" />
        <result column="description" property="description" jdbcType="VARCHAR" />
        <result column="image_url" property="imageUrl" jdbcType="VARCHAR" />
        <result column="original_price" property="originalPrice" jdbcType="BIGINT" />
        <result column="total_stock" property="totalStock" jdbcType="INTEGER" />
        <result column="available_stock" property="availableStock" jdbcType="INTEGER" />
        <result column="status" property="status" jdbcType="TINYINT" />
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP" />
        <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP" />
    </resultMap>
</mapper>