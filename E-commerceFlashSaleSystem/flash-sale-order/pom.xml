<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ghb</groupId>
        <artifactId>flash-sale-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>flash-sale-order</artifactId>
    <name>flash-sale-order</name>
    <description>订单域应用（:8087）：订单查询 + 死信回放 + Stream 消费调度（落单/ACK/重试/榜单）；P4 Day 3</description>

    <dependencies>
        <!-- ========== 内部模块 ========== -->
        <dependency>
            <groupId>com.ghb</groupId>
            <artifactId>flash-sale-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ghb</groupId>
            <artifactId>flash-sale-domain-model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ghb</groupId>
            <artifactId>flash-sale-infra</artifactId>
        </dependency>
        <!-- 用户身份：三个订单查询入口都取 AUTHENTICATED_USER_ID（auth-core 的
             ApiAccessInterceptor 校验令牌后写入的 request attribute）—— 与单体同一机制 -->
        <dependency>
            <groupId>com.ghb</groupId>
            <artifactId>flash-sale-auth-core</artifactId>
        </dependency>
        <!-- 订单域库：SeckillOrderConsumer（建单/ACK/重试/死信）+ OrderQueryService + DeadLetterReplayService
             + OrderQueryAdapter（analytics 的订单读取端口的实现） -->
        <dependency>
            <groupId>com.ghb</groupId>
            <artifactId>flash-sale-order-core</artifactId>
        </dependency>
        <!-- analytics：SeckillOrderConsumer 落单成功后经 SeckillRankService 写实时榜 ZSet（order → analytics，
             现存依赖边）。analytics 只依赖 common/contracts/domain-model/infra（不碰 activity-core），
             其唯一 mapper 是 SeckillActivitySnapshotMapper —— 启动类里三包一起扫。
             TODO（P4 收尾）：order 不再直接依赖 analytics，改为事件驱动（order.created）或端口。 -->
        <dependency>
            <groupId>com.ghb</groupId>
            <artifactId>flash-sale-analytics</artifactId>
        </dependency>

        <!-- ========== Web 层 ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ========== 持久层（order 的三张表仍在旧库，本日不碰数据） ========== -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ========== Redis / Redisson（Stream 消费 + 榜单 ZSet + 消息日志缓存，与单体同一 database=1） ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
        </dependency>

        <!-- ========== .env 环境变量加载（与单体一致：以聚合根为工作目录） ========== -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
        </dependency>

        <!-- ========== 可观测：健康 / 指标 + Prometheus 抓取端点 ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- ========== 服务注册（Nacos：flash-sale-order） ========== -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- ========== 测试 ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- bootable 模块各自声明；库模块不得声明 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
