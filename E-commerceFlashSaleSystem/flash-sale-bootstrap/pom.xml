<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ghb</groupId>
        <artifactId>flash-sale-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>flash-sale-bootstrap</artifactId>
    <name>flash-sale-bootstrap</name>
    <description>启动器：应用入口 + 全局配置 + 跨域集成测试（P0 阶段承载全部现有源码，Day 2~4 逐步迁出到各业务模块）</description>

    <dependencies>
        <!-- ========== 内部模块（P0 Day 2 起逐步迁出，bootstrap 作为装配层聚合） ========== -->
        <dependency>
            <groupId>com.ghb</groupId>
            <artifactId>flash-sale-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ghb</groupId>
            <artifactId>flash-sale-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ghb</groupId>
            <artifactId>flash-sale-domain-model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ghb</groupId>
            <artifactId>flash-sale-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ghb</groupId>
            <artifactId>flash-sale-user</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ghb</groupId>
            <artifactId>flash-sale-product</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ghb</groupId>
            <artifactId>flash-sale-activity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ghb</groupId>
            <artifactId>flash-sale-seckill</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ghb</groupId>
            <artifactId>flash-sale-order</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ghb</groupId>
            <artifactId>flash-sale-analytics</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ghb</groupId>
            <artifactId>flash-sale-ai</artifactId>
        </dependency>

        <!-- ========== Web 层 ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ========== Redis ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ========== Redisson（核心库，非 starter） ========== -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
        </dependency>

        <!-- ========== MyBatis-Plus ========== -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- ========== Validation ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 用户密码单向哈希；只引入密码编码器，不启用整套 Spring Security 过滤链。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- ========== .env 环境变量加载（本地密钥收敛；.env 不入库） ========== -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
        </dependency>

        <!-- ========== 阿里云 OSS（图片存储，本地/OSS 双策略，默认本地） ========== -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
        </dependency>

        <!-- ========== MySQL 驱动 ========== -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- ========== DevTools（开发时热部署） ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 全工程唯一声明 spring-boot-maven-plugin 的模块（库模块不得声明） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--
                        直接执行 spring-boot:run 时，以聚合根为工作目录：
                        .env（MySQL 口令等）与 uploads/ 的相对路径解析与单体时期完全一致。
                        注意：不要写成 <executions>，否则 run 目标会被绑定进生命周期，
                        mvn test-compile 也会启动应用。
                    -->
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
