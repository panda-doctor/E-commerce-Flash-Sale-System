# =====================================================
# 闪电秒杀 · 后端环境变量模板
# =====================================================
# 用法：复制本文件为同目录 .env 并填写真实值，.env 已被 git 忽略。
# 加载：应用启动 / @SpringBootTest（含 mvn test）均会经 spring-dotenv
#       自动读取（以进程工作目录为准，IDEA 与命令行均以本模块目录运行）。
# 优先级：真实系统环境变量 > .env > application.yaml 默认值。
#
# 说明：下方演示令牌/口令为本地演示值，可直接复制使用；
#       生产/共享环境必须换成随机值，且 .env 不得提交进 Git。

# ---- MySQL ----
# 本机 root 演示口令；共享库/云端请填真实口令
MYSQL_PASSWORD=123456

# ---- Redis（S2 加固）----
# 本机演示默认无密码（留空即可）；共享/云端环境务必设置随机密码，后端启动即读取并注入连接
REDIS_PASSWORD=

# ---- 访问令牌（R3 鉴权：空值会拒绝 /api/admin/** 与订单类接口）----
# 管理端令牌：前端 VITE_ADMIN_TOKEN 必须与此一致，否则 401"管理端访问令牌无效"
ADMIN_TOKEN=admin-secret-2026
# 用户令牌:用户ID，多个用英文逗号分隔（默认演示六账号，与前端 store.js DEMO_ACCOUNTS 一一对应）；
# 增删演示账号 = 改此列表 + 前端账号表，两处保持一致；前端请求会按 userId 自动携带匹配令牌
USER_TOKENS=user-a:1001,user-b:1002,user-c:1003,user-d:1004,user-e:1005,user-f:1006

# ---- 阿里云 OSS（默认本地磁盘存储，OSS_ENABLED=false 时无需填 AK/SK）----
OSS_ENABLED=false
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=panda-tea
OSS_DOMAIN=https://panda-tea.oss-cn-beijing.aliyuncs.com

# ---- AI 客服大模型（OpenAI Chat Completions 兼容，默认 DeepSeek）----
# api-key 留空时 /api/support/chat 返回 50300；
# 全量 mvn test 中的 AI 客服用例需要真实 key 才能断言通过（无 key 会失败）
AI_LLM_BASE_URL=https://api.deepseek.com
AI_LLM_API_KEY=
AI_LLM_MODEL=deepseek-chat
