# 观测栈（T5）环境变量模板
# 用法：复制为 deploy/.env（已被 .gitignore 忽略），按需修改后
#       wsl -d redis -- docker compose -f /mnt/d/Project/E-commerceFlashSaleSystem/deploy/docker-compose.yml --profile obs up -d

# Grafana 管理员账号（首次启动写入；演示默认 admin/flashsale，共享环境务必改强密码）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=flashsale
