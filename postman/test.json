            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 状态为 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('业务码符合预期', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.code).to.be.oneOf([0, 40001, 40901, 40902, 42900, 50000]);",
                  "});",
                  "",
                  "pm.test('返回秒杀结果', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json).to.have.property('code');",
                  "  pm.expect(json.data).to.have.property('result');",
                  "  if (json.data.orderNo) {",
                  "    pm.collectionVariables.set('orderNo', json.data.orderNo);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
